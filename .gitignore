# Git worktrees checked out inside the repo (see `git worktree list`).
# The directories are live branch checkouts, not build output -- ignored so
# `git status` stays meaningful, never deleted automatically.
.claude/worktrees/
agent-testkit-wt/

# Diagram plugin ephemeral state
.diagram/

# Node / Next.js (landing site; landing/.gitignore covers these on its own
# branch, but that file is absent on branches without the landing source)
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo

# React SPA (built artifacts are produced by `npm run build` in frontend/spa)
node_modules/
frontend/spa/.vite/
frontend/agentaudit/web/spa_dist/

# Local LLM config: holds endpoints/model names, never keys, but still
# deployment-specific. The committed template is llm.example.yaml.
agentaudit/llm.yaml
.agentaudit/

# tools/analyze_runs.py --format csv output
analysis_out/
