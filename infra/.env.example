# Copy to infra/.env before starting Compose. Never commit infra/.env.
KEYCLOAK_DB_PASSWORD=replace-with-a-random-database-password
KEYCLOAK_ADMIN_USERNAME=replace-with-a-non-default-admin-name
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-random-admin-password
AGENTKIT_CI_ACME_SECRET=replace-with-a-random-client-secret
AGENTKIT_DEMO_USER_PASSWORD=replace-with-a-random-demo-password
