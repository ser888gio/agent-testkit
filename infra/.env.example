# Copy to infra/.env before starting Compose. Never commit infra/.env.

# --- Identity provider -------------------------------------------------------
# Values come from the IdP's discovery document, published at
#   <frontend-api-url>/.well-known/oauth-authorization-server
# Fetch it once and paste the endpoints here; nothing fetches it at runtime.
# For Clerk the frontend-api-url is https://<instance>.clerk.accounts.dev --
# see docs/deploy-clerk.md for the dashboard side (JWT template, org claims).
AGENTAUDIT_OIDC_ISSUER=https://your-instance.example.com
AGENTAUDIT_OIDC_JWKS_URL=https://your-instance.example.com/.well-known/jwks.json
AGENTAUDIT_OIDC_TOKEN_URL=https://your-instance.example.com/oauth/token
AGENTAUDIT_OIDC_AUTH_URL=https://your-instance.example.com/oauth/authorize
# Optional; defaults to <issuer>/oauth/userinfo. Source of org_id/roles/email.
AGENTAUDIT_OIDC_USERINFO_URL=https://your-instance.example.com/oauth/userinfo
AGENTAUDIT_OIDC_AUDIENCE=agentaudit-api
AGENTAUDIT_OIDC_CLIENT_ID=replace-with-the-oauth-application-client-id
# Must also be registered as an allowed redirect URI on the IdP.
AGENTAUDIT_OIDC_REDIRECT_URI=https://demo.example.com/auth/callback
# 0 only for a plain-http loopback experiment; never on a deployed host.
AGENTAUDIT_SESSION_COOKIE_SECURE=1

# --- Demo instance -----------------------------------------------------------
# 1 hides target configs a visitor cannot successfully run, leaving only
# in-process `callable` targets. Set it on any instance strangers can log into.
AGENTAUDIT_DEMO_MODE=0

# --- Tenancy -----------------------------------------------------------------
# 1 lets a user with no Clerk organization log in anyway, into a private tenant
# keyed on their own user id. Use it when you do not want to provision an org
# per user. Leave 0 wherever separate companies share the instance: with it on,
# anyone who can complete a login mints a workspace and can run jobs on the box.
AGENTAUDIT_ALLOW_ORGLESS_LOGIN=0

# --- Attacker / judge model (optional) ---------------------------------------
# Enables generated tests (`agentaudit evolve`) and model-written attack turns
# for every org on this deployment, so a demo visitor needs no key of their own.
# An org that saves its own model under Settings overrides these for its jobs.
#
# Leave ENDPOINT or MODEL empty and the role is off: runs fall back to the
# offline scripted ladder, which is the deterministic default.
#
# Any OpenAI-compatible chat-completions host works. OpenRouter fronts many
# models behind one endpoint; `:free` slugs cost nothing but share a pool.
AGENTAUDIT_ATTACKER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
AGENTAUDIT_ATTACKER_MODEL=minimax/minimax-m3:free
AGENTAUDIT_ATTACKER_API_KEY=replace-with-the-openrouter-key
# Free/shared hosts stall under load. A timeout does NOT fail the run -- it
# silently falls back to the scripted ladder, costing coverage with nothing in
# the report to say the model was never asked. Hence well above the 30s default.
AGENTAUDIT_ATTACKER_TIMEOUT_S=60

# The judge decides whether an attack already landed, replacing the substring
# check. It is a stop condition, never a scorer: assertions still decide
# pass/fail. Safe to leave off.
AGENTAUDIT_JUDGE_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
AGENTAUDIT_JUDGE_MODEL=minimax/minimax-m3:free
AGENTAUDIT_JUDGE_API_KEY=replace-with-the-openrouter-key
AGENTAUDIT_JUDGE_TIMEOUT_S=60

