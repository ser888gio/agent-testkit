{
  "permissions": {
    "allow": [
      "Bash(python -m pytest*)",
      "Bash(.venv/Scripts/python -m pytest*)",
      "Bash(agentaudit *)",
      "Bash(uv run --extra dev pytest*)",
      "Bash(uv run --extra dev ruff*)",
      "Bash(uv sync*)",
      "Bash(uv build)",
      "Bash(uv lock)",
      "Bash(bash tools/affected.sh*)",
      "Bash(bash tools/validate.sh*)",
      "Bash(git diff*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(npm run *)",
      "Bash(python -m pytest tests/test_web.py -q)",
      "Bash(python -m pytest tests/test_web.py -q -k \"test_post_runs_enqueues_without_executing or test_post_runs_enqueues_against_a_registered_target\")",
      "Bash(npx tsc *)",
      "Bash(echo \"=== TSC EXIT: $? ===\")"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/guard-protected-paths.sh\""
          }
        ]
      }
    ]
  }
}
