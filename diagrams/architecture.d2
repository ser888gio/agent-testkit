direction: down

classes: {
  shell: {
    style.stroke: "#3949AB"
    style.stroke-width: 2
    style.border-radius: 12
  }
  core: {
    style.stroke: "#00838F"
    style.stroke-width: 2
    style.border-radius: 8
  }
  domain: {
    style.stroke: "#FF8F00"
    style.stroke-width: 2
    style.border-radius: 8
  }
  data: {
    style.stroke: "#5D4037"
    style.stroke-width: 2
    shape: page
  }
  db: {
    style.stroke: "#E65100"
    style.stroke-width: 2
    shape: cylinder
  }
}

shells: Delivery shells {
  cli: "CLI (Typer) — run / report / compare / ui" {
    class: shell
    icon: https://icons.terrastruct.com/dev%2Fpython.svg
  }
  web: "Dashboard (FastAPI + Jinja2)" {
    class: shell
    icon: https://icons.terrastruct.com/dev%2Fpython.svg
  }
}

core: "Core engine (agentkit/core, depends on nothing internal)" {
  config: "config.py — TargetConfig, env interpolation" {
    class: core
  }
  loader: "loader.py — pack discovery, id/assertion validation" {
    class: core
  }
  runner: "runner.py — execution lifecycle, multi-turn, timeouts" {
    class: core
  }
  agent: "agent.py — Agent protocol, CallableAgent / HTTPAgent" {
    class: core
  }
  sandbox: "sandbox.py — Sandbox contract + registry" {
    class: core
  }
  assertions: "assertions.py — registry + 14 built-ins" {
    class: core
  }
  redaction: "redaction.py — Redactor, EvidencePolicy" {
    class: core
  }
  scoring: "scoring.py — risk-weighted score, CI gate (fails closed)" {
    class: core
  }
  regressions: "regressions.py — run diff / compare" {
    class: core
  }
  compliance: "compliance.py — category to EU AI Act / ISO / NIST / OWASP" {
    class: core
  }
  store: "store.py — SQLite persistence (agentkit.db)" {
    class: db
  }
  schema: "schema.py — shared Pydantic models (dependency root)" {
    class: core
  }
}

domains: "Domain sandboxes (agentkit/domains)" {
  treasury: "Treasury — FakeBank sandbox + demo agent" {
    class: domain
  }
  email: "Email — fake inbox sandbox + demo triage agent" {
    class: domain
  }
}

reports: "Reports (agentkit/reports)" {
  renderers: "Renderers — json / junit / html / md / compliance" {
    class: core
  }
}

packs: "Test packs (agentkit/packs)" {
  corepack: "core — contract, injection, leakage, perf" {
    class: data
  }
  treasurypack: "treasury — 6 payment packs" {
    class: data
  }
  emailpack: "email — exfiltration, phishing, forward" {
    class: data
  }
  agenticpack: "agentic — 6 OWASP ASI attack packs (multi-turn)" {
    class: data
  }
}

# Shells -> core (imports)
shells.cli -> core.config: load target
shells.cli -> core.loader: discover tests
shells.cli -> core.runner: execute run
shells.cli -> core.scoring: score + gate
shells.cli -> core.store: persist / read runs
shells.cli -> core.regressions: compare runs
shells.web -> core.store: read runs / results
shells.web -> core.runner: token-gated re-run {
  style.stroke-dash: 5
}
shells.web -> core.regressions: compare view
shells.cli -> reports.renderers: render output

# Reports -> core
reports.renderers -> core.schema: RunResult models
reports.renderers -> core.scoring: ScoreReport
reports.renderers -> core.compliance: controls_for mapping

# Domains -> core / intra-domain
domains.treasury -> core.sandbox: "@register_sandbox(treasury)"
domains.email -> core.sandbox: "@register_sandbox(email)"

# Core internal dependencies
core.runner -> core.agent: build_agent, run per turn
core.runner -> core.assertions: evaluate
core.runner -> core.config: TargetConfig
core.runner -> core.loader: test cases
core.runner -> core.redaction: redact evidence
core.runner -> core.sandbox: build_sandbox, reset / snapshot / diff
core.runner -> core.schema: result models
core.loader -> core.assertions: validate names
core.loader -> core.schema: TestCase
core.store -> core.config: evidence policy
core.store -> core.redaction: redact on save
core.store -> core.schema: result models
core.store -> core.scoring: score JSON
core.compliance -> core.schema: Category mapping

# Packs are data read by the loader
core.loader -> packs: "discover *.yaml / test_*.py"
