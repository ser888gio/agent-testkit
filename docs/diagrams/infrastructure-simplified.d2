direction: right

user: Operator / CI {
  class: users
  icon: https://icons.terrastruct.com/essentials%2F359-users.svg
}

migrate: "migrate (one-shot)\nagentaudit migrate" {
  class: container
  icon: https://icons.terrastruct.com/dev%2Fdocker.svg
}

web: agentaudit web (FastAPI) {
  class: server
  icon: https://icons.terrastruct.com/tech%2F022-server.svg
}

worker: "Run worker — agentaudit worker\nread-only rootfs, cap_drop ALL,\negress network only" {
  class: container
  icon: https://icons.terrastruct.com/dev%2Fdocker.svg
}

target: Target agent endpoint {
  class: cloud
}

db: "Run store + job queue\n(SQLite on a shared volume)" {
  class: server
  shape: cylinder
}

keycloak: Keycloak (OIDC) {
  class: server
  icon: https://icons.terrastruct.com/dev%2Fdocker.svg
}

kcdb: Keycloak DB (Postgres) {
  class: server
  shape: cylinder
}

user -> web: "HTTP / CLI"
migrate -> db: "alembic schema\n(runs to completion first)"
web -> keycloak: "auth" {style.stroke-dash: 5}
keycloak -> kcdb: "realm state" {style.stroke-dash: 5}
web -> db: "reads runs,\nenqueues jobs"
worker -> db: "claims a leased job,\nwrites redacted results\n(file, not net)"
worker -> target: "black-box calls\n(egress-restricted)"
